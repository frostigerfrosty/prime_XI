{
  "name": "prime-xi",
  "version": "0.16.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run data:check && npm run typecheck && vite build && npm run build:check",
    "build:check": "node scripts/check-build.mjs",
    "preview": "vite preview",
    "data:build": "node scripts/build-data.mjs",
    "data:check": "node scripts/build-data.mjs --check",
    "data:report": "node scripts/report-data.mjs",
    "data:release-check": "node scripts/report-data.mjs --release",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "check": "npm run security:check && npm run ratings:check && npm run translations:check && npm run data:check && npm run typecheck && npm test",
    "test:e2e": "npm run build && playwright test",
    "check:all": "npm run check && npm run test:e2e",
    "match:report": "node scripts/report-match.ts",
    "ratings:build": "node scripts/calibrate-ratings.mjs",
    "ratings:check": "node scripts/calibrate-ratings.mjs --check",
    "ratings:report": "node scripts/calibrate-ratings.mjs --check --report",
    "translations:check": "node scripts/check-translations.mjs",
    "security:audit": "npm audit --audit-level=low",
    "security:check": "node scripts/check-security.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  }
}
